        },
        "614328367": {
          "markers": [],
          "text": "Responsival is a digital marketing agency that specializes in all aspects of business growth through online media.",
          "__type": "RawText"
        },
        "614328368": {
          "tpl": [{ "__ref": "614328216" }],
          "__type": "RenderExpr"
        },
        "614328369": {
          "markers": [],
          "text": "Full-service marketing and design agency specializing in helping startups and e-commerce companies grow.",
          "__type": "RawText"
        },
        "614328370": {
          "tpl": [{ "__ref": "614328324" }],
          "__type": "RenderExpr"
        },
        "614328371": {
          "markers": [],
          "text": "Atlanta, GA, USA",
          "__type": "RawText"
        },
        "614328373": {
          "tpl": [{ "__ref": "614328124" }],
          "__type": "RenderExpr"
        },
        "614328374": {
          "markers": [],
          "text": "Jakarta, Indonesia",
          "__type": "RawText"
        },
        "614328376": {
          "tpl": [{ "__ref": "614328210" }],
          "__type": "RenderExpr"
        },
        "614328377": {
          "markers": [],
          "text": "Seattle, WA; London, UK",
          "__type": "RawText"
        },
        "614328378": {
          "markers": [],
          "text": "Formidable is a global design and engineering consultancy, and open-source software organization, specializing in digital products and transformation.",
          "__type": "RawText"
        },
        "614328379": {
          "tpl": [{ "__ref": "614328012" }],
          "__type": "RenderExpr"
        },
        "614328380": {
          "markers": [],
          "text": "A digital product design + development studio. We are dedicated to the craft of creating purposeful products and experiences that matter.",
          "__type": "RawText"
        },
        "614328381": {
          "tpl": [{ "__ref": "614328018" }],
          "__type": "RenderExpr"
        },
        "614328382": {
          "markers": [],
          "text": "Portland, OR, USA",
          "__type": "RawText"
        },
        "614328384": {
          "markers": [],
          "text": "Echobind is a team of expert product strategists, designers, and software engineers. We ship beautiful, rock-solid apps and websites that transform businesses.",
          "__type": "RawText"
        },
        "614328385": {
          "tpl": [{ "__ref": "614327795" }],
          "__type": "RenderExpr"
        },
        "614328386": {
          "markers": [],
          "text": "Bring ecommerce stores into the sub-second era with PWA technology and beautiful storefront creative.\n",
          "__type": "RawText"
        },
        "614328387": {
          "tpl": [{ "__ref": "614327801" }],
          "__type": "RenderExpr"
        },
        "614328388": {
          "markers": [],
          "text": "Boston, MA, USA",
          "__type": "RawText"
        },
        "614328389": {
          "markers": [],
          "text": "Redding, California",
          "__type": "RawText"
        },
        "614328390": {
          "markers": [],
          "text": "We help medium-sized B2B and B2C companies shape their digital commerce abilities in a smart, modern, and competitive way.",
          "__type": "RawText"
        },
        "614328391": {
          "tpl": [{ "__ref": "614327789" }],
          "__type": "RenderExpr"
        },
        "614328392": {
          "markers": [],
          "text": "Dortmund, Germany",
          "__type": "RawText"
        },
        "614328394": {
          "tpl": [{ "__ref": "614327783" }],
          "__type": "RenderExpr"
        },
        "614328401": {
          "tpl": [{ "__ref": "5466509023" }],
          "__type": "RenderExpr"
        },
        "614328402": {
          "markers": [],
          "text": "Barrel works with brands to grow direct-to-consumer (DTC) ecommerce businesses with a focus on Shopify Plus websites.\n\n",
          "__type": "RawText"
        },
