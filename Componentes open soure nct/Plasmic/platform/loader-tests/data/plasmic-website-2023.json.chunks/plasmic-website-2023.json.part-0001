        "1001129795": {
          "values": {},
          "mixins": [],
          "__type": "RuleSet",
          "animations": null
        },
        "1001129796": {
          "markers": [],
          "text": "James Armenta, the lead engineer defining a new process of rapid experimentation and innovation, evaluated a number of options — from evolving their existing CMS platform, to other page-building solutions. He needed something that could easily plug into Intuit's existing tech stack, while enabling non-engineers users to create rich visual content quickly.",
          "__type": "RawText"
        },
        "1001129799": {
          "values": {},
          "mixins": [],
          "__type": "RuleSet",
          "animations": null
        },
        "1001129800": {
          "markers": [],
          "text": "With Plasmic, Intuit found a solution that helps with:",
          "__type": "RawText"
        },
