        "1491069933": {
          "markers": [],
          "text": "Create headless Shopify storefronts incredibly fast, with or without code. Show product collections, browse variants, add to cart, and more.",
          "__type": "RawText"
        },
        "1491069934": {
          "markers": [],
          "text": "BigCommerce is an ecommerce platform for companies with high revenues and large sales inventories. Create headless storefronts lightning fast.",
          "__type": "RawText"
        },
        "1491069939": {
          "markers": [{ "__ref": "1491069946" }],
          "text": "Commercetools is the world's leading commerce platform built on modern MACH principles (Microservice-based, API-first, Cloud-native and Headless). Enterprise-only integration.",
          "__type": "RawText"
        },
        "1491069940": {
          "markers": [],
          "text": "Swell is a powerful headless ecommerce platform that gives developers, agencies, and merchants around the world the tools to sell the way they want.",
          "__type": "RawText"
        },
        "1491069942": {
          "code": "true",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491069944": {
