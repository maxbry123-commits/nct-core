          "__type": "RuleSet",
          "animations": null
        },
        "1491069971": {
          "markers": [{ "__ref": "1491069972" }],
          "text": "VTEX is the Enterprise Digital Commerce Platform for brands and retailers looking to build a future-proof digital commerce strategy. Enterprise-only integration.",
          "__type": "RawText"
        },
