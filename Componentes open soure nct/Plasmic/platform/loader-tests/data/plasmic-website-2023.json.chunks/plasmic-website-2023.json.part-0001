        },
        "1491070492": {
          "code": "\"https://tally.so/r/3jGZRw\"",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070493": {
          "markers": [],
          "text": "Connect to anything",
          "__type": "RawText"
        },
        "1491070494": {
          "markers": [],
          "text": "Plasmic expert",
          "__type": "RawText"
        },
        "1491070495": {
          "markers": [{ "__ref": "1491070497" }],
          "text": "Become a [child]",
          "__type": "RawText"
        },
        "1491070496": {
          "tpl": [{ "__ref": "759316751" }],
          "__type": "RenderExpr"
        },
        "1491070497": {
          "tpl": { "__ref": "759319264" },
          "position": 9,
          "length": 7,
          "__type": "NodeMarker"
        },
        "1491070498": {
          "param": { "__ref": "5419274888" },
          "expr": { "__ref": "1491070499" },
          "__type": "Arg"
        },
        "1491070499": {
          "variants": [{ "__ref": "5419274892" }],
          "__type": "VariantsRef"
        },
        "1491070500": {
          "markers": [],
          "text": "Want to be featured in our directory of experts? Reach out to our Enterprise team today.",
          "__type": "RawText"
        },
        "1491070501": {
          "tpl": [{ "__ref": "953308892" }],
          "__type": "RenderExpr"
        },
        "1491070502": {
          "markers": [],
          "text": "Contact us",
          "__type": "RawText"
        },
        "1491070503": {
          "code": "\"https://tally.so/r/3jGZRw\"",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070505": {
          "markers": [],
          "text": "New York, NY",
          "__type": "RawText"
        },
        "1491070507": {
          "markers": [],
          "text": "New York, NY",
          "__type": "RawText"
        },
        "1491070508": {
          "markers": [],
          "text": "New York, NY",
          "__type": "RawText"
        },
        "1491070509": {
          "markers": [],
          "text": "Los Angeles, CA",
          "__type": "RawText"
        },
        "1491070510": {
          "markers": [],
          "text": "A full-service marketing and design agency run by former founders of Y-Combinator, specializing in helping startups and e-commerce companies grow.",
          "__type": "RawText"
        },
        "1491070513": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070514": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070515": {
          "markers": [],
          "text": "10k page views",
          "__type": "RawText"
        },
        "1491070516": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070523": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070526": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070535": {
          "text": ["The maximum number of collaborators allowed in the tier."],
          "__type": "TemplatedString"
        },
        "1491070536": {
          "text": [
            "The monthly number of distinct page views across any page on your site that includes a Plasmic design."
          ],
          "__type": "TemplatedString"
        },
        "1491070537": {
          "text": [
            "All Plasmic projects come with a default Plasmic subdomain, but you can choose to use your own custom domain.  "
          ],
          "__type": "TemplatedString"
        },
        "1491070538": {
          "text": [
            "If you have existing Figma designs, you can import them into Plasmic using our best-in-class Figma-to-web converter."
          ],
          "__type": "TemplatedString"
        },
        "1491070539": {
          "text": [
            "Add free-form logic and behavior to your designs. Manage state with ease without worrying about low-level details."
          ],
          "__type": "TemplatedString"
        },
        "1491070540": {
          "text": ["The number of apps and websites you can publish."],
          "__type": "TemplatedString"
        },
        "1491070541": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070542": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070543": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070544": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070547": {
          "code": "false",
          "fallback": null,
          "__type": "CustomCode"
        },
        "1491070548": {
          "text": [
            "Use custom React components—from your own codebase or imported from npm libraries—directly as building blocks in Plasmic Studio."
          ],
          "__type": "TemplatedString"
        },
        "1491070550": {
          "text": ["Add your own branding to the Plasmic studio."],
          "__type": "TemplatedString"
        },
        "1491070551": {
          "text": [
            "Integrate with popular localization frameworks like Lingui, or react-i18next."
          ],
          "__type": "TemplatedString"
        },
        "1491070552": {
          "text": [
            "Fully transfer your Plasmic project to another Plasmic user."
          ],
          "__type": "TemplatedString"
        },
        "1491070553": {
          "text": [
            "Assign permission levels for pre-set roles (admin, developer, designer, editor)."
          ],
          "__type": "TemplatedString"
        },
        "1491070554": {
          "text": [
            "Customize what is enabled or disabled for the content creator role to control the Plasmic visual editing experience."
          ],
          "__type": "TemplatedString"
        },
        "1491070555": {
          "text": ["Support for Okta, Google, and custom SSO providers."],
          "__type": "TemplatedString"
        },
        "1491070556": {
          "text": ["99.5% API and Plasmic hosting availability guarantees."],
          "__type": "TemplatedString"
        },
        "1491070557": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070559" },
          "__type": "Arg"
        },
        "1491070559": {
          "text": [
            "Get answers to your questions in the Plasmic Slack community."
          ],
          "__type": "TemplatedString"
        },
