          "__type": "ImageAssetRef"
        },
        "1491070253": {
          "asset": { "__ref": "6271922373" },
          "__type": "ImageAssetRef"
        },
        "1491070254": {
          "asset": { "__ref": "6271923513" },
          "__type": "ImageAssetRef"
        },
        "1491070255": {
          "asset": { "__ref": "614322006" },
          "__type": "ImageAssetRef"
        },
        "1491070256": {
          "asset": { "__ref": "6271922569" },
          "__type": "ImageAssetRef"
        },
        "1491070257": {
          "asset": { "__ref": "614322004" },
          "__type": "ImageAssetRef"
        },
        "1491070258": {
          "markers": [],
          "text": "Contentful helps digital teams assemble content and deliver experiences, faster. Include Contentful content in your Plasmic surfaces.",
          "__type": "RawText"
        },
        "1491070260": {
          "markers": [],
          "text": "Build digital experiences the way you envisioned them - with all your backends, frontends, and services. Include Hygraph in your Plasmic surfaces.",
          "__type": "RawText"
        },
        "1491070261": {
          "markers": [],
          "text": "Contentstack combines the peace of mind of SaaS with the customization promise of open source. Include Contentstack content directly in your Plasmic surfaces.",
          "__type": "RawText"
        },
        "1491070262": {
          "markers": [],
          "text": "Sanity is the platform for structured content that lets teams build exceptional digital experiences. Include Sanity content directly in your Plasmic surfaces.",
          "__type": "RawText"
        },
        "1491070263": {
          "markers": [],
          "text": "Strapi is the leading open-source headless CMS. It’s 100% JavaScript and fully customizable. Include Strapi content in your Plasmic surfaces.",
          "__type": "RawText"
        },
        "1491070264": {
          "markers": [{ "__ref": "1491070265" }],
          "text": "Drupal is an open source platform for building amazing digital experiences. Enterprise integration only.",
          "__type": "RawText"
        },
        "1491070265": {
          "rs": { "__ref": "1491070266" },
          "position": 76,
          "length": 28,
          "__type": "StyleMarker"
        },
        "1491070266": {
          "values": { "font-weight": "700" },
          "mixins": [],
          "__type": "RuleSet",
          "animations": null
        },
        "1491070268": {
          "markers": [{ "__ref": "1491070269" }],
          "text": "Sitecore combines CMS with customer data, analytics, and marketing automation capabilities. Enterprise-only integration.",
          "__type": "RawText"
        },
        "1491070269": {
          "rs": { "__ref": "1491070270" },
          "position": 92,
