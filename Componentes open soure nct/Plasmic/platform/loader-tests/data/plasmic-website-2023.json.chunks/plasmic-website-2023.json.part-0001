        },
        "1491069964": {
          "markers": [{ "__ref": "1491069966" }],
          "text": "WooCommerce is a popular open source eCommerce plugin for WordPress. Enterprise-only integration.",
          "__type": "RawText"
        },
        "1491069966": {
          "rs": { "__ref": "1491069968" },
          "position": 69,
          "length": 28,
          "__type": "StyleMarker"
        },
        "1491069968": {
          "values": { "font-weight": "700" },
