        "1491069471": {
          "markers": [],
          "text": "Google Optimize",
          "__type": "RawText"
        },
        "1491069472": { "markers": [], "text": "Hubspot", "__type": "RawText" },
        "1491069473": { "markers": [], "text": "Marketo", "__type": "RawText" },
        "1491069474": { "markers": [], "text": "Pardot", "__type": "RawText" },
        "1491069475": {
          "markers": [],
          "text": "Salesforce Marketing",
          "__type": "RawText"
        },
        "1491069476": {
          "markers": [],
          "text": "Rapidly build and deploy A/B tests in Plasmic, but with experiment definition and results integrated with Google Optimize.",
          "__type": "RawText"
        },
        "1491069477": {
          "asset": { "__ref": "6271922821" },
