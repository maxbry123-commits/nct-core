        "1491069482": {
          "markers": [{ "__ref": "1491069484" }],
          "text": "HubSpot's free CRM powers your customer support, sales, and marketing with easy-to-use features like live chat, meeting scheduling, and email tracking. Enterprise-only integration.",
          "__type": "RawText"
        },
        "1491069483": {
          "markers": [{ "__ref": "1491069485" }],
          "text": "Adobe Marketo Engage offers the leading Engagement Platform that empowers marketers to build brand value, grow revenue, and prove impact. Enterprise-only integration.",
          "__type": "RawText"
        },
        "1491069484": {
          "rs": { "__ref": "1491069486" },
          "position": 152,
          "length": 28,
          "__type": "StyleMarker"
        },
        "1491069485": {
          "rs": { "__ref": "1491069487" },
          "position": 138,
