        "1491070244": {
          "markers": [],
          "text": "Contentstack",
          "__type": "RawText"
        },
        "1491070245": { "markers": [], "text": "Sanity", "__type": "RawText" },
        "1491070246": { "markers": [], "text": "Strapi", "__type": "RawText" },
        "1491070247": { "markers": [], "text": "Drupal", "__type": "RawText" },
        "1491070248": {
          "markers": [],
          "text": "Sitecore",
          "__type": "RawText"
        },
        "1491070249": {
          "markers": [],
          "text": "WordPress is a CMS and web publishing software you can use to create a beautiful website or blog. Include Wordpress content in your Plasmic surfaces.",
          "__type": "RawText"
        },
        "1491070250": {
          "asset": { "__ref": "45272164" },
          "__type": "ImageAssetRef"
        },
        "1491070251": {
          "asset": { "__ref": "6271922309" },
          "__type": "ImageAssetRef"
        },
        "1491070252": {
