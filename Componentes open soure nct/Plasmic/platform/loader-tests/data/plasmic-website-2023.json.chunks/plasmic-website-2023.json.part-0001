        "1768686670": {
          "markers": [],
          "text": "SSO and domain capture",
          "__type": "RawText"
        },
        "1768686673": {
          "markers": [],
          "text": "Custom roles and permissions",
          "__type": "RawText"
        },
        "1768686674": {
          "markers": [],
          "text": "Branching and approvals",
          "__type": "RawText"
        },
        "1768686675": {
          "markers": [],
          "text": "Plasmic meets SOC 2 standards for secure handling of sensitive information.",
          "__type": "RawText"
        },
        "1768686677": {
          "markers": [],
          "text": "Shared libraries",
          "__type": "RawText"
        },
        "1768686682": {
          "markers": [],
          "text": "Deploy your applications on-premise or behind firewalls for enhanced control and security.",
          "__type": "RawText"
        },
        "1768686683": {
          "markers": [],
          "text": "Assign and manage fine grained access controls both within Plasmic and your applications.",
          "__type": "RawText"
        },
        "1768686684": {
          "markers": [],
          "text": "Available for for both Plasmic collaborators and end users of your application.",
          "__type": "RawText"
        },
        "1768686686": {
          "markers": [],
          "text": "Centrally manage assets across your organization. Import and reuse within various projects with ease.",
          "__type": "RawText"
        },
        "1768686687": {
          "markers": [],
          "text": "Collaborate at scale by working on isolated copies, then review and merge when ready.",
          "__type": "RawText"
        },
