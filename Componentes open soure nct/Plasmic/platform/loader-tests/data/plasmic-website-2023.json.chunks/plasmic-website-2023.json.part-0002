        "2923038614": {
          "code": "true",
          "fallback": null,
          "__type": "CustomCode"
        },
        "2923038617": {
          "markers": [],
          "text": "React is a free, open-source front-end JavaScript library for building user interfaces based on components.",
          "__type": "RawText"
        },
        "2923038618": {
          "markers": [],
          "text": "Next.js is a React framework that gives you building blocks to create web applications.",
          "__type": "RawText"
        },
        "2923038620": {
          "markers": [],
          "text": "Gatsby is a React-based open source framework with performance, scalability and security built-in. ",
          "__type": "RawText"
        },
        "2923038621": {
          "markers": [],
          "text": "Hydrogen is an interactive coding environment that supports Python, R, and other Jupyter kernels. ",
          "__type": "RawText"
        },
        "2923038622": {
          "markers": [],
          "text": "Remix is a React framework used for server-side rendering (SSR). ",
          "__type": "RawText"
        },
        "2923038623": {
          "markers": [],
          "text": "Vue.js is a JavaScript framework for building user interfaces and single-page applications. ",
          "__type": "RawText"
        },
        "2923038624": {
          "markers": [],
          "text": "Nuxt.js is a free and open source JavaScript library based on Vue.js, Node.js, Vite and Babel.js.",
          "__type": "RawText"
        },
        "2923038625": {
          "markers": [],
          "text": "Angular is a TypeScript-based, free and open-source single-page web application framework",
          "__type": "RawText"
        },
        "2923038626": {
          "markers": [],
          "text": "Javascript is a programming language used for interactive pages.",
          "__type": "RawText"
        },
        "2923038627": {
          "markers": [],
          "text": " PHP is an open-source server-side scripting language that many devs use for web development.",
          "__type": "RawText"
        },
