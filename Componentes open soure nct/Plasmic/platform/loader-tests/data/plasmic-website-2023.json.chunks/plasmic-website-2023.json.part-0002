        "2901735947": { "markers": [], "text": "form", "__type": "RawText" },
        "2901735951": {
          "markers": [],
          "text": "A Plasmic badge appears on any published application or website you build with the free plan. If you want to remove the badge, simply upgrade to a paid tier.",
          "__type": "RawText"
        },
        "2901735952": {
          "markers": [],
          "text": "What is a Plasmic badge on the free plan?",
          "__type": "RawText"
        },
        "2901735953": {
          "markers": [],
          "text": "Is Plasmic secure? How can I be sure my data is safe?",
          "__type": "RawText"
        },
        "2901735963": {
          "markers": [{ "__ref": "2901735965" }],
          "text": "We take security seriously. Our cloud infrastructure is hosted in US data centers that are SOC 1, SOC 2, and ISO 27001 certified. Our data centers have round-the-clock security, fully redundant power systems, two-factor authentication, and physical audit logs. Check out our [child] for more info.",
          "__type": "RawText"
        },
