        },
        "6013082428": {
          "values": {},
          "mixins": [],
          "__type": "RuleSet",
          "animations": null
        },
        "6013082441": {
          "markers": [],
          "text": "Everything you need to build custom web apps with Plasmic. All the tools within one platform— right at your fingertips.",
          "__type": "RawText"
        },
        "6013082442": {
          "markers": [],
          "text": "Plasmic gives you all the building blocks and tools you need to create web apps incredibly fast.",
          "__type": "RawText"
        },
        "6013082444": {
          "uuid": "WP2riSEG7",
          "name": "image 2",
          "type": "picture",
          "dataUri": "https://site-assets.plasmic.app/8ac6935b32dbc695a7ff117e99496b91.png",
          "width": 972,
          "height": 800,
          "aspectRatio": null,
          "__type": "ImageAsset"
        },
        "6013082446": {
          "uuid": "M4ZTac5u_",
          "name": "features-interactions",
          "type": "picture",
          "dataUri": "https://site-assets.plasmic.app/f28aacf4b5874feea1c1e2b25938e4df.png",
          "width": 972,
          "height": 1200,
          "aspectRatio": null,
          "__type": "ImageAsset"
        },
        "6013082447": {
          "asset": { "__ref": "6013082446" },
          "__type": "ImageAssetRef"
        },
        "6013082453": {
          "variants": [{ "__ref": "6065138" }],
          "args": [],
          "attrs": {},
          "rs": { "__ref": "6013082454" },
          "dataCond": null,
          "dataRep": null,
          "text": null,
          "columnsConfig": null,
          "__type": "VariantSetting"
        },
        "6013082454": {
          "values": {},
          "mixins": [],
          "__type": "RuleSet",
          "animations": null
        },
        "6013082456": {
          "markers": [],
          "text": "Connect to popular data sources like Airtable and PostgresQL, generic REST or SQL endpoints, or your own authenticated APIs.",
          "__type": "RawText"
        },
        "6013082457": {
          "markers": [],
          "text": "Read and write data against APIs, databases, and other integrations— all within Plasmic studio.",
          "__type": "RawText"
        },
        "6013082458": {
          "markers": [],
          "text": "Use our Rest API connector to connect with REST APIs, and authenticate with external APIs.",
          "__type": "RawText"
        },
        "6013082459": {
          "markers": [],
          "text": "Start with beautiful themes that look great by default. Or, customize every pixel until it looks exactly the way you want.",
          "__type": "RawText"
        },
        "6013082461": {
          "markers": [],
          "text": "Uphold a consistent design system across your application. Define and manage design elements such as colors, typography, and spacing.",
          "__type": "RawText"
        },
        "6013082462": {
          "markers": [],
          "text": "Define styles that can be reused throughout your application",
          "__type": "RawText"
        },
        "6013082463": {
          "markers": [],
          "text": "Design multiple versions of a single component to create dynamic, responsive interfaces.",
          "__type": "RawText"
        },
        "6013082465": {
          "markers": [],
          "text": "Design components within Plasmic and reuse them across your applications for speed and consistency.",
          "__type": "RawText"
        },
        "6013082472": {
          "markers": [],
          "text": "Unlike other no-code and low-code builders, with Plasmic, you're never trapped in a walled garden.",
          "__type": "RawText"
        },
        "6013082475": {
          "markers": [],
          "text": "Bring your own components, UI elements, data sources, deployment environments, custom controls, and more.",
          "__type": "RawText"
        },
        "6013082476": {
          "markers": [],
          "text": "Bring the best of both worlds together. Let non-developers create and iterate on the front-end of your apps, while giving developers control over the application infrastructure.",
          "__type": "RawText"
        },
        "6013082477": {
          "markers": [],
          "text": "Access a suite of powerful features designed to help you optimize, scale, and improve your app's performance.",
          "__type": "RawText"
        },
        "6013082481": {
          "markers": [],
          "text": "Effortlessly expand your operations and manage enterprise-level growth with ease. Scale up and maintain control, even as your application grows and evolves. ",
          "__type": "RawText"
        },
        "6013082482": {
          "markers": [],
          "text": "Simplify user login with Single Sign-On (SSO) and integrate with existing identity management systems for secure access. Effortlessly manage authentication and authorization for seamless collaboration.",
          "__type": "RawText"
        },
        "6013082486": {
          "markers": [],
          "text": "We blend beautiful design with elegantly crafted code to create practical user experiences that transform viewers into users.\n",
          "__type": "RawText"
        },
        "6013082487": {
          "uuid": "q3dY49BKP",
          "name": "assemble",
          "type": "picture",
          "dataUri": "https://site-assets.plasmic.app/e48549f41f4698fe28989312d36ae2b3.png",
