        "6479118012": {
          "code": "\"html {\\r\\n  scroll-behavior: smooth;\\r\\n}\\r\\n\\r\\n.dashed-underline {\\r\\n     text-decoration:underline;\\r\\n     text-decoration-style: dashed;\\r\\n}\\r\\n\\r\\n.Homepage__heroSection__hpGud {\\r\\n     background-position: 0% -30% !important;\\r\\n     background-size: 100% !important;\\r\\n}\\r\\n.ease-cst {\\r\\n     font-feature-settings: 'ss11' on, 'ss01' on, 'cv10' on, 'calt' off, 'liga' off;\\r\\n     background: linear-gradient(360deg, rgba(255, 255, 255, 0.32) -7.95%, rgba(255, 255, 255, 0.2432) 10.85%, rgba(255, 255, 255, 0.1152) 43.32%, rgba(255, 255, 255, 0.032) 66.39%, rgba(255, 255, 255, 0) 77.5%), linear-gradient(90deg, #00AAFF 0%, #8636F8 100%);\\r\\n     -webkit-background-clip: text;\\r\\n     -webkit-text-fill-color: transparent;\\r\\n     background-clip: text;\\r\\n     text-fill-color: transparent;\\r\\n}\\r\\n.any-data-source {\\r\\n     font-feature-settings: 'ss11' on, 'ss01' on, 'cv10' on, 'calt' off, 'liga' off;\\r\\n     background: linear-gradient(360deg, rgba(255, 255, 255, 0.32) -7.95%, rgba(255, 255, 255, 0.2432) 10.85%, rgba(255, 255, 255, 0.1152) 43.32%, rgba(255, 255, 255, 0.032) 66.39%, rgba(255, 255, 255, 0) 77.5%), linear-gradient(90deg, #00AAFF 0%, #8636F8 100%);\\r\\n     -webkit-background-clip: text;\\r\\n     -webkit-text-fill-color: transparent;\\r\\n     background-clip: text;\\r\\n     text-fill-color: transparent;\\r\\n}\\r\\n.sophistication {\\r\\n     font-feature-settings: 'ss11' on, 'ss01' on, 'cv10' on, 'calt' off, 'liga' off;\\r\\n     background: linear-gradient(360deg, rgba(255, 255, 255, 0.32) -7.95%, rgba(255, 255, 255, 0.2432) 10.85%, rgba(255, 255, 255, 0.1152) 43.32%, rgba(255, 255, 255, 0.032) 66.39%, rgba(255, 255, 255, 0) 77.5%), linear-gradient(90deg, #FFB800 0%, #F8367C 100%);\\r\\n     -webkit-background-clip: text;\\r\\n     -webkit-text-fill-color: transparent;\\r\\n     background-clip: text;\\r\\n     text-fill-color: transparent;\\r\\n}\\r\\n.platform {\\r\\n     