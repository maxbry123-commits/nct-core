        "6178025573": { "markers": [], "text": "GraphQL", "__type": "RawText" },
        "6178025574": {
          "markers": [],
          "text": "Connect to any data source with GraphQL endpoint.",
          "__type": "RawText"
        },
        "6178025575": {
          "code": "true",
          "fallback": null,
          "__type": "CustomCode"
        },
        "6178025577": {
          "markers": [],
          "text": "Connect digital asset management and enrollment to help your brand flourish. \n(Enterprise-only integration)",
          "__type": "RawText"
        },
        "6178025578": {
          "markers": [],
          "text": "World's leading commerce platform built on modern MACH principles. (Enterprise-only integration)",
          "__type": "RawText"
        },
        "6178025579": {
          "markers": [],
          "text": "Drupal is an open source platform for building amazing digital experiences. (Enterprise only)",
          "__type": "RawText"
        },
        "6178025580": {
          "markers": [],
          "text": "Eloqua is a cloud-based marketing automation platform. (Enterprise-only)",
          "__type": "RawText"
        },
        "6178025581": {
          "markers": [],
          "text": "Firebase is an app development platform that helps you build and grow apps and games users love. (Coming soon)",
          "__type": "RawText"
        },
        "6178025582": {
          "markers": [],
          "text": "Grow your business on your terms with Mailchimp's All-In-One marketing, automation & email marketing platform. (Enterprise-only) ",
          "__type": "RawText"
        },
        "6178025583": {
          "markers": [],
          "text": "Pardot is a marketing automation and lead generation tool from Salesforce. (Enterprise-only)",
          "__type": "RawText"
        },
        "6178025584": {
          "markers": [],
          "text": "Sitecore combines CMS with customer data, analytics, and marketing automation capabilities. (Enterprise-only)",
          "__type": "RawText"
        },
        "6178025585": {
          "markers": [],
          "text": "VTEX lets you build, manage, and deliver profitable ecommerce businesses with more agility and less risk. (Enterprise-only)",
          "__type": "RawText"
        },
        "6178025586": {
          "markers": [],
          "text": "WooCommerce is the open-source ecommerce solution for Wordpress-based websites. (Enterprise-only)",
          "__type": "RawText"
        },
        "6178025587": {
          "markers": [],
          "text": "Build beautiful, interactive forms — get more responses.  Create no-code forms, quizzes, and surveys. (Coming soon)",
          "__type": "RawText"
        },
