        "5868372294": {
          "markers": [],
          "text": "Get started with ready-made components",
          "__type": "RawText"
        },
        "5868372295": {
          "markers": [],
          "text": "Choosing from a growing comprehensive library of components, including table, list, grid, inbox, calendar, map, kanban, and more. Customize them to match your specific requirements.",
          "__type": "RawText"
        },
        "5868372296": {
          "markers": [],
          "text": "Create dynamic, interactive experiences for your users via triggers and actions.",
          "__type": "RawText"
        },
        "5868372298": {
          "markers": [],
          "text": "Make any aspect of your app dynamically reflect data from any other part of your app or external source. Create engaging user experiences.",
          "__type": "RawText"
        },
