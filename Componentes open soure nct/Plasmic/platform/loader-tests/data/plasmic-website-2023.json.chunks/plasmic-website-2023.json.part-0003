        "4378272398": {
          "markers": [],
          "text": "Content management",
          "__type": "RawText"
        },
        "4378272443": {
          "markers": [],
          "text": "Websites",
          "__type": "RawText"
        },
        "4378272445": {
          "markers": [],
          "text": "SaaS apps",
          "__type": "RawText"
        },
        "5607197805": {
          "markers": [],
          "text": "Manage and update your app's content with ease, ensuring that your app is always up-to-date and relevant",
          "__type": "RawText"
        },
        "5607197809": {
          "markers": [],
          "text": "Plasmic integrates with localization frameworks so you can easily translate your app's content for users around the world.",
          "__type": "RawText"
        },
        "5607197810": {
          "markers": [],
          "text": "Experiment with different versions of your app to see which performs better. Make data-driven decisions for future updates.",
          "__type": "RawText"
        },
        "5607197811": {
          "markers": [],
          "text": "Optimize your app and website for search engines, making it more visible and discoverable to users",
          "__type": "RawText"
        },
        "5607197812": {
          "markers": [],
          "text": "Reduce the file size of your app's images, without sacrificing quality, to improve overall performance.",
          "__type": "RawText"
        },
        "5607197813": {
          "markers": [],
          "text": "Gain valuable insights into your app's performance and usage to optimize for better engagement.",
          "__type": "RawText"
        },
        "5607197814": {
          "markers": [],
          "text": "Quickly turn your Figma designs into React code for production in Plasmic studio.",
          "__type": "RawText"
        },
