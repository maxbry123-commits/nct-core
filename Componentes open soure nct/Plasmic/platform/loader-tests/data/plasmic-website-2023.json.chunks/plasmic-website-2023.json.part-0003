        "4544425583": {
          "variants": [{ "__ref": "2875831060" }],
          "__type": "VariantsRef"
        },
        "5206826603": {
          "text": [
            "The number of users who sign into your public apps each month. "
          ],
          "__type": "TemplatedString"
        },
        "5206826605": {
          "markers": [],
          "text": "Page views",
          "__type": "RawText"
        },
        "5206826607": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826608" },
          "__type": "Arg"
        },
        "5206826608": {
          "text": [
            "Components are the building blocks for Plasmic projects. Access a growing library of production-ready components, from basic UI elements to major common app views, including table, list, grid, inbox, calendar, map, kanban and more. "
          ],
          "__type": "TemplatedString"
        },
        "5206826609": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826610" },
          "__type": "Arg"
        },
        "5206826610": {
          "text": [
            "Choose from a wide range of pre-built integrations to power your project."
          ],
          "__type": "TemplatedString"
        },
        "5206826611": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826612" },
          "__type": "Arg"
        },
        "5206826612": {
          "text": [
            "Browse a library of pre-built projects and sections that you can copy and customize in minutes.   "
          ],
          "__type": "TemplatedString"
        },
        "5206826613": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070537" },
          "__type": "Arg"
        },
        "5206826615": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826616" },
          "__type": "Arg"
        },
        "5206826616": {
          "text": [
            "We provide reliable and secure hosting for your app or website."
          ],
          "__type": "TemplatedString"
        },
        "5206826617": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826619" },
          "__type": "Arg"
        },
        "5206826618": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826620" },
          "__type": "Arg"
        },
        "5206826619": {
          "text": ["Remove the Plasmic badge from all published projects."],
          "__type": "TemplatedString"
        },
        "5206826620": {
          "text": [
            "Create your own reusable components within Plasmic. Design sections or atomic design system elements that can be used across multiple projects. "
          ],
          "__type": "TemplatedString"
        },
        "5206826621": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070539" },
          "__type": "Arg"
        },
        "5206826622": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826624" },
          "__type": "Arg"
        },
        "5206826624": {
          "text": [
            "Apply colors, fonts, spacing, and more. Design with speed and consistency."
          ],
          "__type": "TemplatedString"
        },
        "5206826625": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070538" },
          "__type": "Arg"
        },
        "5206826629": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826630" },
          "__type": "Arg"
        },
        "5206826630": {
          "text": [
            "Easily control the global styles across your app or website. Display your own branding on your app or website. "
          ],
          "__type": "TemplatedString"
        },
        "5206826631": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070548" },
          "__type": "Arg"
        },
        "5206826633": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826635" },
          "__type": "Arg"
        },
        "5206826634": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826636" },
          "__type": "Arg"
        },
        "5206826635": {
          "text": [
            "Build within your existing applications. Use your own components, data, and code, and compose new screens and components."
          ],
          "__type": "TemplatedString"
        },
        "5206826636": {
          "text": [
            "Customize the Plasmic visual builder to fit your applications and domain. Bring your own custom controls, components, data sources, auth, interactions, and other extensions to Plasmic."
          ],
          "__type": "TemplatedString"
        },
        "5206826637": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070550" },
          "__type": "Arg"
        },
        "5206826639": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826640" },
          "__type": "Arg"
        },
        "5206826640": {
          "text": [
            "Integrate Plasmic as a visual builder within your product."
          ],
          "__type": "TemplatedString"
        },
        "5206826641": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826643" },
          "__type": "Arg"
        },
        "5206826642": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826644" },
          "__type": "Arg"
        },
        "5206826643": {
          "text": [
            "If you need an integration that doesn't exist yet, we'll work with you to get it built."
          ],
          "__type": "TemplatedString"
        },
        "5206826644": {
          "text": [
            "If you need a component that doesn't exist yet, we'll work with you to get it built."
          ],
          "__type": "TemplatedString"
        },
        "5206826645": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826646" },
          "__type": "Arg"
        },
        "5206826646": {
          "text": [
            "A headless API-driven structured content management system."
          ],
          "__type": "TemplatedString"
        },
        "5206826648": {
          "param": { "__ref": "2875830735" },
          "expr": { "__ref": "5206826649" },
          "__type": "Arg"
        },
        "5206826649": {
          "variants": [{ "__ref": "2875830739" }],
          "__type": "VariantsRef"
        },
        "5206826650": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826651" },
          "__type": "Arg"
        },
        "5206826651": {
          "text": [
            "Reduces the file size of your images, without sacrificing quality, to improve overall performance."
          ],
          "__type": "TemplatedString"
        },
        "5206826652": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826653" },
          "__type": "Arg"
        },
        "5206826653": {
          "text": [
            "Real-time collaborative editing—have multiple users editing the same project at the same time."
          ],
          "__type": "TemplatedString"
        },
        "5206826654": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826655" },
          "__type": "Arg"
        },
        "5206826655": {
          "text": [
            "Allow editors to make changes on their own copies of the project. When ready, merge their changes back into the main copy. Review and approve the changes as desired, or resolve conflicts."
          ],
          "__type": "TemplatedString"
        },
        "5206826656": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826657" },
          "__type": "Arg"
        },
        "5206826657": {
          "text": ["Privacy-first analytics with page views."],
          "__type": "TemplatedString"
        },
        "5206826658": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826659" },
          "__type": "Arg"
        },
        "5206826659": {
          "text": [
            "Easily experiment with multiple variations of a page to measure which is more effective. Promote the winning edits as the main copy. Support multiple concurrent A/B tests at the same time."
          ],
          "__type": "TemplatedString"
        },
        "5206826660": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826662" },
          "__type": "Arg"
        },
        "5206826661": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826663" },
          "__type": "Arg"
        },
        "5206826662": {
          "text": [
            "Create a different variation of a page that is activated during a time interval, such as a holiday promotion."
          ],
          "__type": "TemplatedString"
        },
        "5206826663": {
          "text": [
            "Create a different variation of a page that is activated under certain conditions, such as when the user has a certain item in their shopping cart."
          ],
          "__type": "TemplatedString"
        },
        "5206826664": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070551" },
          "__type": "Arg"
        },
        "5206826666": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826667" },
          "__type": "Arg"
        },
        "5206826667": {
          "text": [
            "API access to programmatically create full snapshot representations of any project."
          ],
          "__type": "TemplatedString"
        },
        "5206826668": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826670" },
          "__type": "Arg"
        },
        "5206826669": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070552" },
          "__type": "Arg"
        },
        "5206826670": {
          "text": [
            "Generate human-manageable source code. Eject at any time with your code, or continuously sync code for your components and interface with them via an API."
          ],
          "__type": "TemplatedString"
        },
        "5206826672": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826673" },
          "__type": "Arg"
        },
        "5206826673": {
          "text": [
            "Retain version history of your projects by saving commits. Roll back or view past versions, and branch/merge projects."
          ],
          "__type": "TemplatedString"
        },
        "5206826674": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070553" },
          "__type": "Arg"
        },
        "5206826678": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826680" },
          "__type": "Arg"
        },
        "5206826679": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070554" },
          "__type": "Arg"
        },
        "5206826680": {
          "text": [
            "Enables a streamlined editing experience with full content control, but allows admin to limit styling options and predefine the building blocks, customizable per workspace and project."
          ],
          "__type": "TemplatedString"
        },
        "5206826682": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826684" },
          "__type": "Arg"
        },
        "5206826683": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070555" },
          "__type": "Arg"
        },
        "5206826684": {
          "text": [
            "Ensure that all Plasmic users who sign up with @yourcompany.com are automatically managed as part of your team."
          ],
          "__type": "TemplatedString"
        },
        "5206826766": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "1491070556" },
          "__type": "Arg"
        },
        "5206826768": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826770" },
          "__type": "Arg"
        },
        "5206826769": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826771" },
          "__type": "Arg"
        },
        "5206826770": {
          "text": [
            "We typically respond within 2 business days. Faster response times for priority requests.  "
          ],
          "__type": "TemplatedString"
        },
        "5206826771": {
          "text": ["24-hour response time guarantee."],
          "__type": "TemplatedString"
        },
        "5206826772": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826774" },
          "__type": "Arg"
        },
        "5206826773": {
          "param": { "__ref": "4544425520" },
          "expr": { "__ref": "5206826775" },
          "__type": "Arg"
        },
        "5206826774": {
          "text": [
            "Training and integration to ensure you are able to successfully get started with Plasmic."
          ],
          "__type": "TemplatedString"
        },
        "5206826775": {
          "text": [
            "Direct line to our engineering and product teams for questions and feedback."
          ],
          "__type": "TemplatedString"
        },
