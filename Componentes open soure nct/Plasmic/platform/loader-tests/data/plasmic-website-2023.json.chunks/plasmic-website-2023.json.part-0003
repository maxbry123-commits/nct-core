op: 1px;right: 1px;bottom: 1px;left: 1px; border-radius: 14px;}\\r\\n.price-grandient-global {box-shadow: none !important;}\\r\\n.bdr-gradient-1 {background: linear-gradient(90deg, #8636F8 2.26%, #F020B3 34.84%);}\\r\\n.bdr-gradient-2 {background: linear-gradient(90deg, #FFB800 2.26%, #F8367C 34.84%);}\\r\\n.bdr-gradient-3 {background: linear-gradient(90deg, #00AAFF 2.26%, #8636F8 34.84%);}\\r\\nhtml {\\r\\n  scroll-behavior: smooth;\\r\\n}\\r\\n.number-grandient {\\r\\n    font-feature-settings: 'ss11' on, 'ss01' on, 'cv10' on, 'calt' off, 'liga' off;\\r\\n    background: linear-gradient(360deg, rgba(255, 255, 255, 0.8) -7.95%, rgba(255, 255, 255, 0.608) 8.42%, rgba(255, 255, 255, 0.288) 36.7%, rgba(255, 255, 255, 0.08) 56.8%, rgba(255, 255, 255, 0) 66.48%), linear-gradient(81.31deg, #8636F8 2.26%, #F020B3 34.84%, #F8475E 67.42%, #FF9421 100%);\\r\\n    -webkit-background-clip: text;\\r\\n    -webkit-text-fill-color: transparent;\\r\\n    background-clip: text;\\r\\n    text-fill-color: transparent;\\r\\n}\\r\\n\\r\\n.get-started-hero {\\r\\n    position: relative;\\r\\n    outline: 1px solid;\\r\\n    outline-offset: 8px;\\r\\n    border-radius: 999px;\\r\\n    outline-color: #f8475e26;\\r\\n}\\r\\n\\r\\n\\r\\n.footer-radial-bg .list a:hover, .footer-radial-bg .terms a:hover {\\r\\n     text-decoration: underline;\\r\\n}\"",
