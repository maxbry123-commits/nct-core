    <!-- http://purl.obolibrary.org/obo/CDAO_0000099 -->

    <owl:Class rdf:about="&obo;CDAO_0000099">
        <rdfs:label rdf:datatype="&xsd;string">Edge</rdfs:label>
        <rdfs:subClassOf rdf:resource="&owl;Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
