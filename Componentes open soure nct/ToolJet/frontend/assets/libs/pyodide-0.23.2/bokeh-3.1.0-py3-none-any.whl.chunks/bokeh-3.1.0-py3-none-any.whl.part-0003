                        FunctionDeclaration: {
                            type: "object",
                            properties: {
                                parameters: ELEMENT_LIST_SCHEMA,
                                body: {
                                    type: "integer",
                                    minimum: 0
                                }
                            },
                            additionalProperties: false
                        },
                        FunctionExpression: {
                            type: "object",
                            properties: {
                                parameters: ELEMENT_LIST_SCHEMA,
                                body: {
                                    type: "integer",
                                    minimum: 0
                                }
                            },
                            additionalProperties: false
                        },
                        StaticBlock: {
                            type: "object",
                            properties: {
                                body: {
                                    type: "integer",
                                    minimum: 0
