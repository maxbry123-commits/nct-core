import cv2


NativeMethodPatchedResult = namedtuple("NativeMethodPatchedResult",
                                       ("py", "native"))


def testOverwriteNativeMethod(arg):
    return NativeMethodPatchedResult(
        arg + 1,
        cv2.utils._native.testOverwriteNativeMethod(arg)
    )
