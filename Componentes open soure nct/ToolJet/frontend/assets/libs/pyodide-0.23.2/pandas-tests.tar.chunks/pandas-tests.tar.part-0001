        df = DataFrame(np.abs(np.random.randn(10, 2)))
        df_err = DataFrame(np.abs(np.random.randn(10, 2)))
        ax = _check_plot_works(df.plot, yerr=df_err)
        self._check_has_errorbars(ax, xerr=0, yerr=2)
