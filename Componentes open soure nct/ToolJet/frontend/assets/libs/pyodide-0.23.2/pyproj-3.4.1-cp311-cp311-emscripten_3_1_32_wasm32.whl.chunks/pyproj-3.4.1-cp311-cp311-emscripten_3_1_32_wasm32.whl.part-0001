        return cls.from_json_dict(
            {
                "type": "CoordinateSystem",
                "subtype": "ellipsoidal",
                "axis": _ELLIPSOIDAL_3D_AXIS_MAP[Ellipsoidal3DCSAxis.create(axis)],
            }
        )


