    >>> from sympy import pprint, symbols
    >>> from sympy.physics.optics.polarization import quarter_wave_retarder
    >>> theta= symbols("theta", real=True)
    >>> QWP = quarter_wave_retarder(theta)
    >>> pprint(QWP, use_unicode=True)
    âŽ¡                       -â…ˆâ‹…Ï€            -â…ˆâ‹…Ï€               âŽ¤
