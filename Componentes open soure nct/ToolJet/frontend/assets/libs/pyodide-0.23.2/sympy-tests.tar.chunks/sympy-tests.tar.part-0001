def test_complicated_symbol_unchanged():
    for symb_name in ["dexpr2_d1tau", "dexpr2^d1tau"]:
        assert pretty(Symbol(symb_name)) == symb_name


def test_categories():
    from sympy.categories import (Object, IdentityMorphism,
        NamedMorphism, Category, Diagram, DiagramGrid)

    A1 = Object("A1")
    A2 = Object("A2")
    A3 = Object("A3")

    f1 = NamedMorphism(A1, A2, "f1")
    f2 = NamedMorphism(A2, A3, "f2")
    id_A1 = IdentityMorphism(A1)

    K1 = Category("K1")

    assert pretty(A1) == "A1"
    assert upretty(A1) == "A‚ÇÅ"

    assert pretty(f1) == "f1:A1-->A2"
    assert upretty(f1) == "f‚ÇÅ:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÇ"
    assert pretty(id_A1) == "id:A1-->A1"
    assert upretty(id_A1) == "id:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÅ"

    assert pretty(f2*f1) == "f2*f1:A1-->A3"
    assert upretty(f2*f1) == "f‚ÇÇ‚àòf‚ÇÅ:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÉ"

    assert pretty(K1) == "K1"
    assert upretty(K1) == "K‚ÇÅ"

    # Test how diagrams are printed.
    d = Diagram()
    assert pretty(d) == "EmptySet"
    assert upretty(d) == "‚àÖ"

    d = Diagram({f1: "unique", f2: S.EmptySet})
    assert pretty(d) == "{f2*f1:A1-->A3: EmptySet, id:A1-->A1: " \
        "EmptySet, id:A2-->A2: EmptySet, id:A3-->A3: " \
        "EmptySet, f1:A1-->A2: {unique}, f2:A2-->A3: EmptySet}"

    assert upretty(d) == "{f‚ÇÇ‚àòf‚ÇÅ:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÉ: ‚àÖ, id:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÅ: ‚àÖ, " \
        "id:A‚ÇÇ‚Äî‚Äî‚ñ∂A‚ÇÇ: ‚àÖ, id:A‚ÇÉ‚Äî‚Äî‚ñ∂A‚ÇÉ: ‚àÖ, f‚ÇÅ:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÇ: {unique}, f‚ÇÇ:A‚ÇÇ‚Äî‚Äî‚ñ∂A‚ÇÉ: ‚àÖ}"

    d = Diagram({f1: "unique", f2: S.EmptySet}, {f2 * f1: "unique"})
    assert pretty(d) == "{f2*f1:A1-->A3: EmptySet, id:A1-->A1: " \
        "EmptySet, id:A2-->A2: EmptySet, id:A3-->A3: " \
        "EmptySet, f1:A1-->A2: {unique}, f2:A2-->A3: EmptySet}" \
        " ==> {f2*f1:A1-->A3: {unique}}"
    assert upretty(d) == "{f‚ÇÇ‚àòf‚ÇÅ:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÉ: ‚àÖ, id:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÅ: ‚àÖ, id:A‚ÇÇ‚Äî‚Äî‚ñ∂A‚ÇÇ: " \
        "‚àÖ, id:A‚ÇÉ‚Äî‚Äî‚ñ∂A‚ÇÉ: ‚àÖ, f‚ÇÅ:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÇ: {unique}, f‚ÇÇ:A‚ÇÇ‚Äî‚Äî‚ñ∂A‚ÇÉ: ‚àÖ}" \
        " ‚ïê‚ïê‚ñ∂ {f‚ÇÇ‚àòf‚ÇÅ:A‚ÇÅ‚Äî‚Äî‚ñ∂A‚ÇÉ: {unique}}"

    grid = DiagramGrid(d)
    assert pretty(grid) == "A1  A2\n      \nA3    "
    assert upretty(grid) == "A‚ÇÅ  A‚ÇÇ\n      \nA‚ÇÉ    "


def test_PrettyModules():
    R = QQ.old_poly_ring(x, y)
    F = R.free_module(2)
    M = F.submodule([x, y], [1, x**2])

    ucode_str = \
"""\
       2\n\
‚Ñö[x, y] \
"""
    ascii_str = \
"""\
        2\n\
QQ[x, y] \
"""

    assert upretty(F) == ucode_str
    assert pretty(F) == ascii_str

    ucode_str = \
"""\
‚ï±        ‚é°    2‚é§‚ï≤\n\
‚ï≤[x, y], ‚é£1, x ‚é¶‚ï±\
"""
    ascii_str = \
"""\
              2  \n\
<[x, y], [1, x ]>\
"""

    assert upretty(M) == ucode_str
    assert pretty(M) == ascii_str

    I = R.ideal(x**2, y)

    ucode_str = \
"""\
‚ï± 2   ‚ï≤\n\
‚ï≤x , y‚ï±\
"""

    ascii_str = \
"""\
  2    \n\
<x , y>\
"""

    assert upretty(I) == ucode_str
    assert pretty(I) == ascii_str

    Q = F / M

    ucode_str = \
"""\
            2    \n\
     ‚Ñö[x, y]     \n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n\
‚ï±        ‚é°    2‚é§‚ï≤\n\
‚ï≤[x, y], ‚é£1, x ‚é¶‚ï±\
"""

    ascii_str = \
"""\
            2    \n\
    QQ[x, y]     \n\
-----------------\n\
              2  \n\
<[x, y], [1, x ]>\
"""

    assert upretty(Q) == ucode_str
    assert pretty(Q) == ascii_str

    ucode_str = \
"""\
‚ï±‚é°    3‚é§                                                ‚ï≤\n\
‚îÇ‚é¢   x ‚é•   ‚ï±        ‚é°    2‚é§‚ï≤           ‚ï±        ‚é°    2‚é§‚ï≤‚îÇ\n\
‚îÇ‚é¢1, ‚îÄ‚îÄ‚é• + ‚ï≤[x, y], ‚é£1, x ‚é¶‚ï±, [2, y] + ‚ï≤[x, y], ‚é£1, x ‚é¶‚ï±‚îÇ\n\
‚ï≤‚é£   2 ‚é¶                                                ‚ï±\
"""

    ascii_str = \
"""\
      3                                                  \n\
     x                   2                           2   \n\
<[1, --] + <[x, y], [1, x ]>, [2, y] + <[x, y], [1, x ]>>\n\
     2                                                   \
"""


def test_QuotientRing():
    R = QQ.old_poly_ring(x)/[x**2 + 1]

    ucode_str = \
"""\
  ‚Ñö[x]  \n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n\
‚ï± 2    ‚ï≤\n\
‚ï≤x  + 1‚ï±\
"""

    ascii_str = \
"""\
 QQ[x]  \n\
--------\n\
  2     \n\
<x  + 1>\
"""

    assert upretty(R) == ucode_str
    assert pretty(R) == ascii_str

    ucode_str = \
"""\
    ‚ï± 2    ‚ï≤\n\
1 + ‚ï≤x  + 1‚ï±\
"""

    ascii_str = \
"""\
      2     \n\
1 + <x  + 1>\
"""

    assert upretty(R.one) == ucode_str
    assert pretty(R.one) == ascii_str


def test_Homomorphism():
    from sympy.polys.agca import homomorphism

    R = QQ.old_poly_ring(x)

    expr = homomorphism(R.free_module(1), R.free_module(1), [0])

    ucode_str = \
"""\
          1         1\n\
[0] : ‚Ñö[x]  ‚îÄ‚îÄ> ‚Ñö[x] \
"""

    ascii_str = \
"""\
           1          1\n\
[0] : QQ[x]  --> QQ[x] \
"""

    assert upretty(expr) == ucode_str
    assert pretty(expr) == ascii_str

    expr = homomorphism(R.free_module(2), R.free_module(2), [0, 0])

    ucode_str = \
"""\
‚é°0  0‚é§       2         2\n\
‚é¢    ‚é• : ‚Ñö[x]  ‚îÄ‚îÄ> ‚Ñö[x] \n\
‚é£0  0‚é¶                  \
"""

    ascii_str = \
"""\
[0  0]        2          2\n\
[    ] : QQ[x]  --> QQ[x] \n\
[0  0]                    \
"""

    assert upretty(expr) == ucode_str
    assert pretty(expr) == ascii_str

    expr = homomorphism(R.free_module(1), R.free_module(1) / [[x]], [0])

    ucode_str = \
"""\
                    1\n\
          1     ‚Ñö[x] \n\
[0] : ‚Ñö[x]  ‚îÄ‚îÄ> ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n\
                <[x]>\
"""

    ascii_str = \
"""\
                      1\n\
           1     QQ[x] \n\
[0] : QQ[x]  --> ------\n\
                 <[x]> \
"""

    assert upretty(expr) == ucode_str
    assert pretty(expr) == ascii_str


def test_Tr():
    A, B = symbols('A B', commutative=False)
    t = Tr(A*B)
    assert pretty(t) == r'Tr(A*B)'
    assert upretty(t) == 'Tr(A‚ãÖB)'


def test_pretty_Add():
    eq = Mul(-2, x - 2, evaluate=False) + 5
    assert pretty(eq) == '5 - 2*(x - 2)'


def test_issue_7179():
    assert upretty(Not(Equivalent(x, y))) == 'x ‚áé y'
    assert upretty(Not(Implies(x, y))) == 'x ‚Üõ y'


