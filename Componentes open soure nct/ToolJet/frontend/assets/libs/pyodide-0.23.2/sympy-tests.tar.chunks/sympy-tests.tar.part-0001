      ‚éõ x + y ‚éû ‚éõx - y‚éû      \n\
      ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü      \n\
      ‚éùx - 2‚ãÖy‚é† ‚éùx + y‚é†      \n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n\
1   ‚éõ x + y ‚éû ‚éõx - y‚éû ‚éõ1 - x‚éû\n\
‚îÄ - ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
1   ‚éùx - 2‚ãÖy‚é† ‚éùx + y‚é† ‚éùx - y‚é†\
"""
    expected10 = \
"""\
  ‚éõ1 - x‚éû  \n\
  ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü  \n\
  ‚éùx - y‚é†  \n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n\
1   ‚éõ1 - x‚éû\n\
‚îÄ - ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
1   ‚éùx - y‚é†\
"""
    assert upretty(Feedback(tf, tf1)) == expected1
    assert upretty(Feedback(tf, tf2*tf1*tf3)) == expected2
    assert upretty(Feedback(tf1, tf2*tf3*tf5)) == expected3
    assert upretty(Feedback(tf1*tf2, tf)) == expected4
    assert upretty(Feedback(tf1*tf2, tf5)) == expected5
    assert upretty(Feedback(tf3*tf5, tf2*tf1)) == expected6
    assert upretty(Feedback(tf4, tf6)) == expected7
    assert upretty(Feedback(tf5, tf)) == expected8

    assert upretty(Feedback(tf1*tf2, tf5, 1)) == expected9
    assert upretty(Feedback(tf5, tf, 1)) == expected10


def test_pretty_MIMOFeedback():
    tf1 = TransferFunction(x + y, x - 2*y, y)
    tf2 = TransferFunction(x - y, x + y, y)
    tfm_1 = TransferFunctionMatrix([[tf1, tf2], [tf2, tf1]])
    tfm_2 = TransferFunctionMatrix([[tf2, tf1], [tf1, tf2]])
    tfm_3 = TransferFunctionMatrix([[tf1, tf1], [tf2, tf2]])

    expected1 = \
"""\
‚éõ    ‚é° x + y    x - y ‚é§  ‚é° x - y    x + y ‚é§ ‚éû-1   ‚é° x + y    x - y ‚é§ \n\
‚éú    ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•  ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• ‚éü     ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• \n\
‚éú    ‚é¢x - 2‚ãÖy   x + y ‚é•  ‚é¢ x + y   x - 2‚ãÖy‚é• ‚éü     ‚é¢x - 2‚ãÖy   x + y ‚é• \n\
‚éúI - ‚é¢                ‚é• ‚ãÖ‚é¢                ‚é• ‚éü   ‚ãÖ ‚é¢                ‚é• \n\
‚éú    ‚é¢ x - y    x + y ‚é•  ‚é¢ x + y    x - y ‚é• ‚éü     ‚é¢ x - y    x + y ‚é• \n\
‚éú    ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• ‚éü     ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚éù    ‚é£ x + y   x - 2‚ãÖy‚é¶œÑ ‚é£x - 2‚ãÖy   x + y ‚é¶œÑ‚é†     ‚é£ x + y   x - 2‚ãÖy‚é¶œÑ\
"""
    expected2 = \
"""\
‚éõ    ‚é° x + y    x - y ‚é§  ‚é° x - y    x + y ‚é§  ‚é° x + y    x + y ‚é§ ‚éû-1   ‚é° x + y    x - y ‚é§  ‚é° x - y    x + y ‚é§ \n\
‚éú    ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•  ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• ‚éü     ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•  ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚éú    ‚é¢x - 2‚ãÖy   x + y ‚é•  ‚é¢ x + y   x - 2‚ãÖy‚é•  ‚é¢x - 2‚ãÖy  x - 2‚ãÖy‚é• ‚éü     ‚é¢x - 2‚ãÖy   x + y ‚é•  ‚é¢ x + y   x - 2‚ãÖy‚é• \n\
‚éúI + ‚é¢                ‚é• ‚ãÖ‚é¢                ‚é• ‚ãÖ‚é¢                ‚é• ‚éü   ‚ãÖ ‚é¢                ‚é• ‚ãÖ‚é¢                ‚é• \n\
‚éú    ‚é¢ x - y    x + y ‚é•  ‚é¢ x + y    x - y ‚é•  ‚é¢ x - y    x - y ‚é• ‚éü     ‚é¢ x - y    x + y ‚é•  ‚é¢ x + y    x - y ‚é• \n\
‚éú    ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•  ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ    ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• ‚éü     ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• \n\
‚éù    ‚é£ x + y   x - 2‚ãÖy‚é¶œÑ ‚é£x - 2‚ãÖy   x + y ‚é¶œÑ ‚é£ x + y    x + y ‚é¶œÑ‚é†     ‚é£ x + y   x - 2‚ãÖy‚é¶œÑ ‚é£x - 2‚ãÖy   x + y ‚é¶œÑ\
"""

    assert upretty(MIMOFeedback(tfm_1, tfm_2, 1)) == \
        expected1  # Positive MIMOFeedback
    assert upretty(MIMOFeedback(tfm_1*tfm_2, tfm_3)) == \
        expected2  # Negative MIMOFeedback (Default)


def test_pretty_TransferFunctionMatrix():
    tf1 = TransferFunction(x + y, x - 2*y, y)
    tf2 = TransferFunction(x - y, x + y, y)
    tf3 = TransferFunction(y**2 - 2*y + 1, y + 5, y)
    tf4 = TransferFunction(y, x**2 + x + 1, y)
    tf5 = TransferFunction(1 - x, x - y, y)
    tf6 = TransferFunction(2, 2, y)
    expected1 = \
"""\
‚é° x + y ‚é§ \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é¢x - 2‚ãÖy‚é• \n\
‚é¢       ‚é• \n\
‚é¢ x - y ‚é• \n\
‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• \n\
‚é£ x + y ‚é¶œÑ\
"""
    expected2 = \
"""\
‚é°    x + y     ‚é§ \n\
‚é¢   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ    ‚é• \n\
‚é¢   x - 2‚ãÖy    ‚é• \n\
‚é¢              ‚é• \n\
‚é¢    x - y     ‚é• \n\
‚é¢    ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ     ‚é• \n\
‚é¢    x + y     ‚é• \n\
‚é¢              ‚é• \n\
‚é¢   2          ‚é• \n\
‚é¢- y  + 2‚ãÖy - 1‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é£    y + 5     ‚é¶œÑ\
"""
    expected3 = \
"""\
‚é°   x + y        x - y   ‚é§ \n\
‚é¢  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ       ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚é• \n\
‚é¢  x - 2‚ãÖy       x + y   ‚é• \n\
‚é¢                        ‚é• \n\
‚é¢ 2                      ‚é• \n\
‚é¢y  - 2‚ãÖy + 1      y     ‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é¢   y + 5       2        ‚é• \n\
‚é¢              x  + x + 1‚é• \n\
‚é¢                        ‚é• \n\
‚é¢   1 - x          2     ‚é• \n\
‚é¢   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ          ‚îÄ     ‚é• \n\
‚é£   x - y          2     ‚é¶œÑ\
"""
    expected4 = \
"""\
‚é°    x - y        x + y       y     ‚é§ \n\
‚é¢    ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ       ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é¢    x + y       x - 2‚ãÖy   2        ‚é• \n\
‚é¢                         x  + x + 1‚é• \n\
‚é¢                                   ‚é• \n\
‚é¢   2                               ‚é• \n\
‚é¢- y  + 2‚ãÖy - 1   x - 1      -2     ‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ      ‚îÄ‚îÄ‚îÄ    ‚é• \n\
‚é£    y + 5        x - y       2     ‚é¶œÑ\
"""
    expected5 = \
"""\
‚é° x + y  x - y   x + y       y     ‚é§ \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚ãÖ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é¢x - 2‚ãÖy x + y  x - 2‚ãÖy   2        ‚é• \n\
‚é¢                        x  + x + 1‚é• \n\
‚é¢                                  ‚é• \n\
‚é¢  1 - x   2     x + y      -2     ‚é• \n\
‚é¢  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚îÄ    ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ     ‚îÄ‚îÄ‚îÄ    ‚é• \n\
‚é£  x - y   2    x - 2‚ãÖy      2     ‚é¶œÑ\
"""

    assert upretty(TransferFunctionMatrix([[tf1], [tf2]])) == expected1
    assert upretty(TransferFunctionMatrix([[tf1], [tf2], [-tf3]])) == expected2
    assert upretty(TransferFunctionMatrix([[tf1, tf2], [tf3, tf4], [tf5, tf6]])) == expected3
    assert upretty(TransferFunctionMatrix([[tf2, tf1, tf4], [-tf3, -tf5, -tf6]])) == expected4
    assert upretty(TransferFunctionMatrix([[Series(tf2, tf1), tf1, tf4], [Parallel(tf6, tf5), tf1, -tf6]])) == \
        expected5


def test_pretty_order():
    expr = O(1)
    ascii_str = \
"""\
O(1)\
"""
    ucode_str = \
"""\
O(1)\
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = O(1/x)
    ascii_str = \
"""\
 /1\\\n\
O|-|\n\
 \\x/\
"""
    ucode_str = \
"""\
 ‚éõ1‚éû\n\
O‚éú‚îÄ‚éü\n\
 ‚éùx‚é†\
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = O(x**2 + y**2)
    ascii_str = \
"""\
 / 2    2                  \\\n\
O\\x  + y ; (x, y) -> (0, 0)/\
"""
    ucode_str = \
"""\
 ‚éõ 2    2                 ‚éû\n\
O‚éùx  + y ; (x, y) ‚Üí (0, 0)‚é†\
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = O(1, (x, oo))
    ascii_str = \
"""\
O(1; x -> oo)\
"""
    ucode_str = \
"""\
O(1; x ‚Üí ‚àû)\
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = O(1/x, (x, oo))
    ascii_str = \
"""\
 /1         \\\n\
O|-; x -> oo|\n\
 \\x         /\
"""
    ucode_str = \
"""\
 ‚éõ1       ‚éû\n\
O‚éú‚îÄ; x ‚Üí ‚àû‚éü\n\
 ‚éùx       ‚é†\
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = O(x**2 + y**2, (x, oo), (y, oo))
    ascii_str = \
"""\
 / 2    2                    \\\n\
O\\x  + y ; (x, y) -> (oo, oo)/\
"""
    ucode_str = \
"""\
 ‚éõ 2    2                 ‚éû\n\
O‚éùx  + y ; (x, y) ‚Üí (‚àû, ‚àû)‚é†\
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str


def test_pretty_derivatives():
    # Simple
    expr = Derivative(log(x), x, evaluate=False)
    ascii_str = \
"""\
d         \n\
--(log(x))\n\
dx        \
"""
    ucode_str = \
"""\
d         \n\
‚îÄ‚îÄ(log(x))\n\
dx        \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Derivative(log(x), x, evaluate=False) + x
    ascii_str_1 = \
"""\
    d         \n\
x + --(log(x))\n\
    dx        \
"""
    ascii_str_2 = \
"""\
d             \n\
--(log(x)) + x\n\
dx            \
"""
    ucode_str_1 = \
"""\
    d         \n\
x + ‚îÄ‚îÄ(log(x))\n\
    dx        \
"""
    ucode_str_2 = \
"""\
d             \n\
‚îÄ‚îÄ(log(x)) + x\n\
dx            \
"""
    assert pretty(expr) in [ascii_str_1, ascii_str_2]
    assert upretty(expr) in [ucode_str_1, ucode_str_2]

    # basic partial derivatives
    expr = Derivative(log(x + y) + x, x)
    ascii_str_1 = \
"""\
d                 \n\
--(log(x + y) + x)\n\
dx                \
"""
    ascii_str_2 = \
"""\
d                 \n\
--(x + log(x + y))\n\
dx                \
"""
    ucode_str_1 = \
"""\
‚àÇ                 \n\
‚îÄ‚îÄ(log(x + y) + x)\n\
‚àÇx                \
"""
    ucode_str_2 = \
"""\
‚àÇ                 \n\
‚îÄ‚îÄ(x + log(x + y))\n\
‚àÇx                \
"""
    assert pretty(expr) in [ascii_str_1, ascii_str_2]
    assert upretty(expr) in [ucode_str_1, ucode_str_2], upretty(expr)

    # Multiple symbols
    expr = Derivative(log(x) + x**2, x, y)
    ascii_str_1 = \
"""\
   2              \n\
  d  /          2\\\n\
-----\\log(x) + x /\n\
dy dx             \
"""
    ascii_str_2 = \
"""\
   2              \n\
  d  / 2         \\\n\
-----\\x  + log(x)/\n\
dy dx             \
"""
    ucode_str_1 = \
"""\
   2              \n\
  d  ‚éõ          2‚éû\n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éùlog(x) + x ‚é†\n\
dy dx             \
"""
    ucode_str_2 = \
"""\
   2              \n\
  d  ‚éõ 2         ‚éû\n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éùx  + log(x)‚é†\n\
dy dx             \
"""
    assert pretty(expr) in [ascii_str_1, ascii_str_2]
    assert upretty(expr) in [ucode_str_1, ucode_str_2]

    expr = Derivative(2*x*y, y, x) + x**2
    ascii_str_1 = \
"""\
   2             \n\
  d             2\n\
-----(2*x*y) + x \n\
dx dy            \
"""
    ascii_str_2 = \
"""\
        2        \n\
 2     d         \n\
x  + -----(2*x*y)\n\
     dx dy       \
"""
    ucode_str_1 = \
"""\
   2             \n\
  ‚àÇ             2\n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ(2‚ãÖx‚ãÖy) + x \n\
‚àÇx ‚àÇy            \
"""
    ucode_str_2 = \
"""\
        2        \n\
 2     ‚àÇ         \n\
x  + ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ(2‚ãÖx‚ãÖy)\n\
     ‚àÇx ‚àÇy       \
"""
    assert pretty(expr) in [ascii_str_1, ascii_str_2]
    assert upretty(expr) in [ucode_str_1, ucode_str_2]

    expr = Derivative(2*x*y, x, x)
    ascii_str = \
"""\
  2       \n\
 d        \n\
---(2*x*y)\n\
  2       \n\
dx        \
"""
    ucode_str = \
"""\
  2       \n\
 ‚àÇ        \n\
‚îÄ‚îÄ‚îÄ(2‚ãÖx‚ãÖy)\n\
  2       \n\
‚àÇx        \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Derivative(2*x*y, x, 17)
    ascii_str = \
"""\
 17        \n\
d          \n\
----(2*x*y)\n\
  17       \n\
dx         \
"""
    ucode_str = \
"""\
 17        \n\
‚àÇ          \n\
‚îÄ‚îÄ‚îÄ‚îÄ(2‚ãÖx‚ãÖy)\n\
  17       \n\
‚àÇx         \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Derivative(2*x*y, x, x, y)
    ascii_str = \
"""\
   3         \n\
  d          \n\
------(2*x*y)\n\
     2       \n\
dy dx        \
"""
    ucode_str = \
"""\
   3         \n\
  ‚àÇ          \n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ(2‚ãÖx‚ãÖy)\n\
     2       \n\
‚àÇy ‚àÇx        \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    # Greek letters
    alpha = Symbol('alpha')
    beta = Function('beta')
    expr = beta(alpha).diff(alpha)
    ascii_str = \
"""\
  d                \n\
------(beta(alpha))\n\
dalpha             \
"""
    ucode_str = \
"""\
d       \n\
‚îÄ‚îÄ(Œ≤(Œ±))\n\
dŒ±      \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Derivative(f(x), (x, n))

    ascii_str = \
"""\
  n      \n\
 d       \n\
---(f(x))\n\
  n      \n\
dx       \
"""
    ucode_str = \
"""\
  n      \n\
 d       \n\
‚îÄ‚îÄ‚îÄ(f(x))\n\
  n      \n\
dx       \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str


def test_pretty_integrals():
    expr = Integral(log(x), x)
    ascii_str = \
"""\
  /         \n\
 |          \n\
 | log(x) dx\n\
 |          \n\
/           \
"""
    ucode_str = \
"""\
‚å†          \n\
‚éÆ log(x) dx\n\
‚å°          \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Integral(x**2, x)
    ascii_str = \
"""\
  /     \n\
 |      \n\
 |  2   \n\
 | x  dx\n\
 |      \n\
/       \
"""
    ucode_str = \
"""\
‚å†      \n\
‚éÆ  2   \n\
‚éÆ x  dx\n\
‚å°      \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Integral((sin(x))**2 / (tan(x))**2)
    ascii_str = \
"""\
  /          \n\
 |           \n\
 |    2      \n\
 | sin (x)   \n\
 | ------- dx\n\
 |    2      \n\
 | tan (x)   \n\
 |           \n\
/            \
"""
    ucode_str = \
"""\
‚å†           \n\
‚éÆ    2      \n\
‚éÆ sin (x)   \n\
‚éÆ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ dx\n\
‚éÆ    2      \n\
‚éÆ tan (x)   \n\
‚å°           \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Integral(x**(2**x), x)
    ascii_str = \
"""\
  /        \n\
 |         \n\
 |  / x\\   \n\
 |  \\2 /   \n\
 | x     dx\n\
 |         \n\
/          \
"""
    ucode_str = \
"""\
‚å†         \n\
‚éÆ  ‚éõ x‚éû   \n\
‚éÆ  ‚éù2 ‚é†   \n\
‚éÆ x     dx\n\
‚å°         \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Integral(x**2, (x, 1, 2))
    ascii_str = \
"""\
  2      \n\
  /      \n\
 |       \n\
 |   2   \n\
 |  x  dx\n\
 |       \n\
/        \n\
1        \
"""
    ucode_str = \
"""\
2      \n\
‚å†      \n\
‚éÆ  2   \n\
‚éÆ x  dx\n\
‚å°      \n\
1      \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Integral(x**2, (x, Rational(1, 2), 10))
    ascii_str = \
"""\
 10      \n\
  /      \n\
 |       \n\
 |   2   \n\
 |  x  dx\n\
 |       \n\
/        \n\
1/2      \
"""
    ucode_str = \
"""\
 10      \n\
 ‚å†       \n\
 ‚éÆ   2   \n\
 ‚éÆ  x  dx\n\
 ‚å°       \n\
1/2      \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Integral(x**2*y**2, x, y)
    ascii_str = \
"""\
  /  /           \n\
 |  |            \n\
 |  |  2  2      \n\
 |  | x *y  dx dy\n\
 |  |            \n\
/  /             \
"""
    ucode_str = \
"""\
‚å† ‚å†            \n\
‚éÆ ‚éÆ  2  2      \n\
‚éÆ ‚éÆ x ‚ãÖy  dx dy\n\
‚å° ‚å°            \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Integral(sin(th)/cos(ph), (th, 0, pi), (ph, 0, 2*pi))
    ascii_str = \
"""\
 2*pi pi                           \n\
   /   /                           \n\
  |   |                            \n\
