‚éú‚îÄ‚éü \n\
‚éùx‚é† \
"""

    assert upretty(he**2) == ucode_str

    ucode_str = \
"""\
    1\n\
1 + ‚îÄ\n\
    x\
"""

    assert upretty(he + 1) == ucode_str

    ucode_str = \
('''\
  1\n\
x‚ãÖ‚îÄ\n\
  x\
''')
    assert upretty(x*he) == ucode_str


