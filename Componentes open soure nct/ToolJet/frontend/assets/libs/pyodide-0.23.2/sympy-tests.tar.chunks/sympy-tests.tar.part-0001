    assert upretty(expr) == ucode_str

    ascii_str = \
"""\
 / |  1  \\\n\
E|1|-----|\n\
 \\ |z + 1/\
"""
    ucode_str = \
"""\
 ‚éõ ‚îÇ  1  ‚éû\n\
E‚éú1‚îÇ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
 ‚éù ‚îÇz + 1‚é†\
