    assert upretty(expr) == ucode_str

    ascii_str = \
"""\
 /  1  \\\n\
E|-----|\n\
 \\z + 1/\
"""
    ucode_str = \
"""\
 ‚éõ  1  ‚éû\n\
E‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
 ‚éùz + 1‚é†\
"""
    expr = elliptic_e(1/(z + 1))
