    ascii_str = \
"""\
  /   4| \\\n\
Pi|3; -|6|\n\
  \\   x| /\
"""
    ucode_str = \
"""\
 ‚éõ   4‚îÇ ‚éû\n\
Œ†‚éú3; ‚îÄ‚îÇ6‚éü\n\
 ‚éù   x‚îÇ ‚é†\
"""
    expr = elliptic_pi(3, 4/x, 6)
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str


def test_RandomDomain():
    from sympy.stats import Normal, Die, Exponential, pspace, where
    X = Normal('x1', 0, 1)
    assert upretty(where(X > 0)) == "Domain: 0 < x‚ÇÅ ‚àß x‚ÇÅ < ‚àû"

    D = Die('d1', 6)
    assert upretty(where(D > 4)) == 'Domain: d‚ÇÅ = 5 ‚à® d‚ÇÅ = 6'

    A = Exponential('a', 1)
    B = Exponential('b', 1)
    assert upretty(pspace(Tuple(A, B)).domain) == \
        'Domain: 0 ‚â§ a ‚àß 0 ‚â§ b ‚àß a < ‚àû ‚àß b < ‚àû'


def test_PrettyPoly():
    F = QQ.frac_field(x, y)
    R = QQ.poly_ring(x, y)

    expr = F.convert(x/(x + y))
    assert pretty(expr) == "x/(x + y)"
    assert upretty(expr) == "x/(x + y)"

    expr = R.convert(x + y)
    assert pretty(expr) == "x + y"
    assert upretty(expr) == "x + y"


def test_issue_6285():
    assert pretty(Pow(2, -5, evaluate=False)) == '1 \n--\n 5\n2 '
    assert pretty(Pow(x, (1/pi))) == \
    ' 1 \n'\
    ' --\n'\
    ' pi\n'\
    'x  '


def test_issue_6359():
    assert pretty(Integral(x**2, x)**2) == \
"""\
          2
/  /     \\ \n\
| |      | \n\
| |  2   | \n\
| | x  dx| \n\
| |      | \n\
\\/       / \
"""
    assert upretty(Integral(x**2, x)**2) == \
"""\
         2
‚éõ‚å†      ‚éû \n\
‚éú‚éÆ  2   ‚éü \n\
‚éú‚éÆ x  dx‚éü \n\
‚éù‚å°      ‚é† \
"""

    assert pretty(Sum(x**2, (x, 0, 1))**2) == \
"""\
          2
/  1     \\ \n\
| ___    | \n\
| \\  `   | \n\
|  \\    2| \n\
|  /   x | \n\
| /__,   | \n\
\\x = 0   / \
"""
    assert upretty(Sum(x**2, (x, 0, 1))**2) == \
"""\
          2
‚éõ  1     ‚éû \n\
‚éú ___    ‚éü \n\
‚éú ‚ï≤      ‚éü \n\
‚éú  ‚ï≤    2‚éü \n\
‚éú  ‚ï±   x ‚éü \n\
‚éú ‚ï±      ‚éü \n\
‚éú ‚Äæ‚Äæ‚Äæ    ‚éü \n\
‚éùx = 0   ‚é† \
"""

    assert pretty(Product(x**2, (x, 1, 2))**2) == \
"""\
           2
/  2      \\ \n\
|______   | \n\
| |  |   2| \n\
| |  |  x | \n\
| |  |    | \n\
\\x = 1    / \
"""
    assert upretty(Product(x**2, (x, 1, 2))**2) == \
"""\
           2
‚éõ  2      ‚éû \n\
‚éú‚îÄ‚î¨‚îÄ‚îÄ‚î¨‚îÄ   ‚éü \n\
‚éú ‚îÇ  ‚îÇ   2‚éü \n\
‚éú ‚îÇ  ‚îÇ  x ‚éü \n\
‚éú ‚îÇ  ‚îÇ    ‚éü \n\
‚éùx = 1    ‚é† \
"""

    f = Function('f')
    assert pretty(Derivative(f(x), x)**2) == \
"""\
          2
/d       \\ \n\
|--(f(x))| \n\
\\dx      / \
"""
    assert upretty(Derivative(f(x), x)**2) == \
"""\
          2
‚éõd       ‚éû \n\
‚éú‚îÄ‚îÄ(f(x))‚éü \n\
‚éùdx      ‚é† \
"""

