def test_pretty_product():
    n, m, k, l = symbols('n m k l')
    f = symbols('f', cls=Function)
    expr = Product(f((n/3)**2), (n, k**2, l))

    unicode_str = \
"""\
    l           \n\
‚îÄ‚î¨‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î¨‚îÄ      \n\
 ‚îÇ      ‚îÇ   ‚éõ 2‚éû\n\
 ‚îÇ      ‚îÇ   ‚éún ‚éü\n\
 ‚îÇ      ‚îÇ  f‚éú‚îÄ‚îÄ‚éü\n\
 ‚îÇ      ‚îÇ   ‚éù9 ‚é†\n\
 ‚îÇ      ‚îÇ       \n\
       2        \n\
  n = k         """
    ascii_str = \
"""\
    l           \n\
__________      \n\
 |      |   / 2\\\n\
 |      |   |n |\n\
 |      |  f|--|\n\
 |      |   \\9 /\n\
 |      |       \n\
       2        \n\
  n = k         """

    expr = Product(f((n/3)**2), (n, k**2, l), (l, 1, m))

    unicode_str = \
"""\
    m          l           \n\
‚îÄ‚î¨‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î¨‚îÄ ‚îÄ‚î¨‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚î¨‚îÄ      \n\
 ‚îÇ      ‚îÇ   ‚îÇ      ‚îÇ   ‚éõ 2‚éû\n\
 ‚îÇ      ‚îÇ   ‚îÇ      ‚îÇ   ‚éún ‚éü\n\
 ‚îÇ      ‚îÇ   ‚îÇ      ‚îÇ  f‚éú‚îÄ‚îÄ‚éü\n\
 ‚îÇ      ‚îÇ   ‚îÇ      ‚îÇ   ‚éù9 ‚é†\n\
 ‚îÇ      ‚îÇ   ‚îÇ      ‚îÇ       \n\
  l = 1           2        \n\
             n = k         """
    ascii_str = \
"""\
    m          l           \n\
__________ __________      \n\
 |      |   |      |   / 2\\\n\
 |      |   |      |   |n |\n\
 |      |   |      |  f|--|\n\
 |      |   |      |   \\9 /\n\
 |      |   |      |       \n\
  l = 1           2        \n\
             n = k         """

    assert pretty(expr) == ascii_str
    assert upretty(expr) == unicode_str


def test_pretty_Lambda():
    # S.IdentityFunction is a special case
    expr = Lambda(y, y)
    assert pretty(expr) == "x -> x"
    assert upretty(expr) == "x ‚Ü¶ x"

    expr = Lambda(x, x+1)
    assert pretty(expr) == "x -> x + 1"
    assert upretty(expr) == "x ‚Ü¶ x + 1"

    expr = Lambda(x, x**2)
    ascii_str = \
"""\
      2\n\
x -> x \
"""
    ucode_str = \
"""\
     2\n\
x ‚Ü¶ x \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Lambda(x, x**2)**2
    ascii_str = \
"""\
         2
/      2\\ \n\
\\x -> x / \
"""
    ucode_str = \
"""\
        2
‚éõ     2‚éû \n\
‚éùx ‚Ü¶ x ‚é† \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Lambda((x, y), x)
    ascii_str = "(x, y) -> x"
    ucode_str = "(x, y) ‚Ü¶ x"
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Lambda((x, y), x**2)
    ascii_str = \
"""\
           2\n\
(x, y) -> x \
"""
    ucode_str = \
"""\
          2\n\
(x, y) ‚Ü¶ x \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str

    expr = Lambda(((x, y),), x**2)
    ascii_str = \
"""\
              2\n\
((x, y),) -> x \
"""
    ucode_str = \
"""\
             2\n\
((x, y),) ‚Ü¶ x \
"""
    assert pretty(expr) == ascii_str
    assert upretty(expr) == ucode_str


def test_pretty_TransferFunction():
    tf1 = TransferFunction(s - 1, s + 1, s)
    assert upretty(tf1) == "s - 1\n‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\ns + 1"
    tf2 = TransferFunction(2*s + 1, 3 - p, s)
    assert upretty(tf2) == "2‚ãÖs + 1\n‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n 3 - p "
    tf3 = TransferFunction(p, p + 1, p)
    assert upretty(tf3) == "  p  \n‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\np + 1"


def test_pretty_Series():
    tf1 = TransferFunction(x + y, x - 2*y, y)
    tf2 = TransferFunction(x - y, x + y, y)
    tf3 = TransferFunction(x**2 + y, y - x, y)
    tf4 = TransferFunction(2, 3, y)

    tfm1 = TransferFunctionMatrix([[tf1, tf2], [tf3, tf4]])
    tfm2 = TransferFunctionMatrix([[tf3], [-tf4]])
    tfm3 = TransferFunctionMatrix([[tf1, -tf2, -tf3], [tf3, -tf4, tf2]])
    tfm4 = TransferFunctionMatrix([[tf1, tf2], [tf3, -tf4], [-tf2, -tf1]])
    tfm5 = TransferFunctionMatrix([[-tf2, -tf1], [tf4, -tf3], [tf1, tf2]])

    expected1 = \
"""\
          ‚éõ 2    ‚éû\n\
‚éõ x + y ‚éû ‚éúx  + y‚éü\n\
‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
‚éùx - 2‚ãÖy‚é† ‚éù-x + y‚é†\
"""
    expected2 = \
"""\
‚éõ-x + y‚éû ‚éõ -x - y‚éû\n\
‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
‚éùx + y ‚é† ‚éùx - 2‚ãÖy‚é†\
"""
    expected3 = \
"""\
‚éõ 2    ‚éû                            \n\
‚éúx  + y‚éü ‚éõ x + y ‚éû ‚éõ -x - y   x - y‚éû\n\
‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
‚éù-x + y‚é† ‚éùx - 2‚ãÖy‚é† ‚éùx - 2‚ãÖy   x + y‚é†\
"""
    expected4 = \
"""\
                  ‚éõ         2    ‚éû\n\
‚éõ x + y    x - y‚éû ‚éúx - y   x  + y‚éü\n\
‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
‚éùx - 2‚ãÖy   x + y‚é† ‚éùx + y   -x + y‚é†\
"""
    expected5 = \
"""\
‚é° x + y   x - y‚é§  ‚é° 2    ‚é§ \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•  ‚é¢x  + y‚é• \n\
‚é¢x - 2‚ãÖy  x + y‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é¢              ‚é•  ‚é¢-x + y‚é• \n\
‚é¢ 2            ‚é• ‚ãÖ‚é¢      ‚é• \n\
‚é¢x  + y     2  ‚é•  ‚é¢ -2   ‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ     ‚îÄ  ‚é•  ‚é¢ ‚îÄ‚îÄ‚îÄ  ‚é• \n\
‚é£-x + y     3  ‚é¶œÑ ‚é£  3   ‚é¶œÑ\
"""
    expected6 = \
"""\
                                               ‚éõ‚é° x + y    x - y ‚é§    ‚é° x - y    x + y ‚é§ ‚éû\n\
                                               ‚éú‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•    ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• ‚éü\n\
‚é° x + y   x - y‚é§  ‚é°                    2    ‚é§  ‚éú‚é¢x - 2‚ãÖy   x + y ‚é•    ‚é¢ x + y   x - 2‚ãÖy‚é• ‚éü\n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•  ‚é¢ x + y   -x + y  - x  - y‚é•  ‚éú‚é¢                ‚é•    ‚é¢                ‚é• ‚éü\n\
‚é¢x - 2‚ãÖy  x + y‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•  ‚éú‚é¢ 2              ‚é•    ‚é¢          2     ‚é• ‚éü\n\
‚é¢              ‚é•  ‚é¢x - 2‚ãÖy  x + y    -x + y ‚é•  ‚éú‚é¢x  + y     -2   ‚é•    ‚é¢  -2     x  + y ‚é• ‚éü\n\
‚é¢ 2            ‚é• ‚ãÖ‚é¢                         ‚é• ‚ãÖ‚éú‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ     ‚îÄ‚îÄ‚îÄ  ‚é•  + ‚é¢  ‚îÄ‚îÄ‚îÄ    ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• ‚éü\n\
‚é¢x  + y     2  ‚é•  ‚é¢ 2                       ‚é•  ‚éú‚é¢-x + y      3   ‚é•    ‚é¢   3     -x + y ‚é• ‚éü\n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ     ‚îÄ  ‚é•  ‚é¢x  + y    -2      x - y  ‚é•  ‚éú‚é¢                ‚é•    ‚é¢                ‚é• ‚éü\n\
‚é£-x + y     3  ‚é¶œÑ ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ    ‚îÄ‚îÄ‚îÄ     ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚é•  ‚éú‚é¢-x + y    -x - y‚é•    ‚é¢ -x - y  -x + y ‚é• ‚éü\n\
                  ‚é£-x + y     3      x + y  ‚é¶œÑ ‚éú‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•    ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• ‚éü\n\
                                               ‚éù‚é£x + y    x - 2‚ãÖy‚é¶œÑ   ‚é£x - 2‚ãÖy  x + y  ‚é¶œÑ‚é†\
"""

    assert upretty(Series(tf1, tf3)) == expected1
    assert upretty(Series(-tf2, -tf1)) == expected2
    assert upretty(Series(tf3, tf1, Parallel(-tf1, tf2))) == expected3
    assert upretty(Series(Parallel(tf1, tf2), Parallel(tf2, tf3))) == expected4
    assert upretty(MIMOSeries(tfm2, tfm1)) == expected5
    assert upretty(MIMOSeries(MIMOParallel(tfm4, -tfm5), tfm3, tfm1)) == expected6


def test_pretty_Parallel():
    tf1 = TransferFunction(x + y, x - 2*y, y)
    tf2 = TransferFunction(x - y, x + y, y)
    tf3 = TransferFunction(x**2 + y, y - x, y)
    tf4 = TransferFunction(y**2 - x, x**3 + x, y)

    tfm1 = TransferFunctionMatrix([[tf1, tf2], [tf3, -tf4], [-tf2, -tf1]])
    tfm2 = TransferFunctionMatrix([[-tf2, -tf1], [tf4, -tf3], [tf1, tf2]])
    tfm3 = TransferFunctionMatrix([[-tf1, tf2], [-tf3, tf4], [tf2, tf1]])
    tfm4 = TransferFunctionMatrix([[-tf1, -tf2], [-tf3, -tf4]])

    expected1 = \
"""\
 x + y    x - y\n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n\
x - 2‚ãÖy   x + y\
"""
    expected2 = \
"""\
-x + y    -x - y\n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n\
x + y    x - 2‚ãÖy\
"""
    expected3 = \
"""\
 2                                  \n\
x  + y    x + y    ‚éõ -x - y‚éû ‚éõx - y‚éû\n\
‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ + ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
-x + y   x - 2‚ãÖy   ‚éùx - 2‚ãÖy‚é† ‚éùx + y‚é†\
"""
    expected4 = \
"""\
                            ‚éõ 2    ‚éû\n\
‚éõ x + y ‚éû ‚éõx - y‚éû   ‚éõx - y‚éû ‚éúx  + y‚éü\n\
‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü + ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü‚ãÖ‚éú‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
‚éùx - 2‚ãÖy‚é† ‚éùx + y‚é†   ‚éùx + y‚é† ‚éù-x + y‚é†\
"""
    expected5 = \
"""\
‚é° x + y   -x + y ‚é§    ‚é° x - y    x + y ‚é§    ‚é° x + y    x - y ‚é§ \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•    ‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•    ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• \n\
‚é¢x - 2‚ãÖy  x + y  ‚é•    ‚é¢ x + y   x - 2‚ãÖy‚é•    ‚é¢x - 2‚ãÖy   x + y ‚é• \n\
‚é¢                ‚é•    ‚é¢                ‚é•    ‚é¢                ‚é• \n\
‚é¢ 2            2 ‚é•    ‚é¢     2    2     ‚é•    ‚é¢ 2            2 ‚é• \n\
‚é¢x  + y   x - y  ‚é•    ‚é¢x - y    x  + y ‚é•    ‚é¢x  + y   x - y  ‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•  + ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•  + ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• \n\
‚é¢-x + y    3     ‚é•    ‚é¢ 3       -x + y ‚é•    ‚é¢-x + y    3     ‚é• \n\
‚é¢         x  + x ‚é•    ‚é¢x  + x          ‚é•    ‚é¢         x  + x ‚é• \n\
‚é¢                ‚é•    ‚é¢                ‚é•    ‚é¢                ‚é• \n\
‚é¢-x + y    -x - y‚é•    ‚é¢ -x - y  -x + y ‚é•    ‚é¢-x + y    -x - y‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•    ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•    ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é£x + y    x - 2‚ãÖy‚é¶œÑ   ‚é£x - 2‚ãÖy  x + y  ‚é¶œÑ   ‚é£x + y    x - 2‚ãÖy‚é¶œÑ\
"""
    expected6 = \
"""\
‚é° x - y    x + y ‚é§                        ‚é°-x + y    -x - y ‚é§ \n\
‚é¢ ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•                        ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• \n\
‚é¢ x + y   x - 2‚ãÖy‚é•  ‚é° -x - y   -x + y‚é§    ‚é¢x + y    x - 2‚ãÖy ‚é• \n\
‚é¢                ‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•    ‚é¢                 ‚é• \n\
‚é¢     2    2     ‚é•  ‚é¢x - 2‚ãÖy   x + y ‚é•    ‚é¢      2     2    ‚é• \n\
‚é¢x - y    x  + y ‚é•  ‚é¢                ‚é•    ‚é¢-x + y   - x  - y‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é• ‚ãÖ‚é¢   2           2‚é•  + ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é• \n\
‚é¢ 3       -x + y ‚é•  ‚é¢- x  - y  x - y ‚é•    ‚é¢  3       -x + y ‚é• \n\
‚é¢x  + x          ‚é•  ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚é•    ‚é¢ x  + x          ‚é• \n\
‚é¢                ‚é•  ‚é¢ -x + y    3    ‚é•    ‚é¢                 ‚é• \n\
‚é¢ -x - y  -x + y ‚é•  ‚é£          x  + x‚é¶œÑ   ‚é¢ x + y    x - y  ‚é• \n\
‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ ‚é•                        ‚é¢‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ   ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ  ‚é• \n\
‚é£x - 2‚ãÖy  x + y  ‚é¶œÑ                       ‚é£x - 2‚ãÖy   x + y  ‚é¶œÑ\
"""

    assert upretty(Parallel(tf1, tf2)) == expected1
    assert upretty(Parallel(-tf2, -tf1)) == expected2
    assert upretty(Parallel(tf3, tf1, Series(-tf1, tf2))) == expected3
    assert upretty(Parallel(Series(tf1, tf2), Series(tf2, tf3))) == expected4
    assert upretty(MIMOParallel(-tfm3, -tfm2, tfm1)) == expected5
    assert upretty(MIMOParallel(MIMOSeries(tfm4, -tfm2), tfm2)) == expected6


def test_pretty_Feedback():
