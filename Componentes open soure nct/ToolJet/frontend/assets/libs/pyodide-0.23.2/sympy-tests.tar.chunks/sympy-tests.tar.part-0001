F|1|-----|\n\
 \\ |z + 1/\
"""
    ucode_str = \
"""\
 ‚éõ ‚îÇ  1  ‚éû\n\
F‚éú1‚îÇ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚éü\n\
 ‚éù ‚îÇz + 1‚é†\
"""
    expr = elliptic_f(1, 1/(1 + z))
