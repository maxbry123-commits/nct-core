    cdef Split * split
    cdef int level
    cdef int point_in_node(self, np.float64_t[:] point)
    cdef Node _find_node(self, np.float64_t[:] point)
    cdef int _kd_is_leaf(self)
    cdef add_grid(self, np.float64_t[:] gle, np.float64_t[:] gre,
                       int gid,
                       int rank,
                       int size)
    cdef insert_grid(self,
