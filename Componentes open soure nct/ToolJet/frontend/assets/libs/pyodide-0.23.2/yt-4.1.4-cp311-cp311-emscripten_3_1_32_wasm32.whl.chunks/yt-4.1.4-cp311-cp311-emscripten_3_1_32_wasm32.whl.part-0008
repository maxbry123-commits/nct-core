            opos[2] = opos[3] = pos[1] + dds[1]
            for j in range(nn[1]):
                # We start at level zero.  In the future we could optimize by
                # retaining oct information from previous cells.
                if not ((opos[0] <= pos[0] <= opos[1]) and
                        (opos[2] <= pos[1] <= opos[3])):
