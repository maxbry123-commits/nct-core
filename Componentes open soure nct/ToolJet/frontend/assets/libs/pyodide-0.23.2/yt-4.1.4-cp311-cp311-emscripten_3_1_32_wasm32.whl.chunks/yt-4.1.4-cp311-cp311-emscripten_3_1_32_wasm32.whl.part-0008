        bbox.right_edge[j] = tet_patch.v[0][j]

    for i in range(1, 6):
        for j in range(3):
            bbox.left_edge[j] = fmin(bbox.left_edge[j], tet_patch.v[i][j])
            bbox.right_edge[j] = fmax(bbox.right_edge[j], tet_patch.v[i][j])
