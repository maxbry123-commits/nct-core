def check_all_vertices(sampler, vertices, field_values):
    NV = vertices.shape[0]
    NDIM = vertices.shape[1]
    x = np.empty(NDIM)
    for i in range(NV):
        x = vertices[i]
        val = sampler(vertices, field_values, x)
        assert_almost_equal(val, field_values[i])


