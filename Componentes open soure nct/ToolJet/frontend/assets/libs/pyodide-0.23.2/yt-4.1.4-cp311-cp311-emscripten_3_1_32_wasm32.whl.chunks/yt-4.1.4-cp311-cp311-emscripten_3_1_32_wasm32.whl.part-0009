        ds,
        "z",
        fields=fields,
    )
    eps_fig = eps.multiplot_yt(2, 1, slc, bare_axes=True)
    eps_fig.scale_line(0.2, "5 cm")
    savefile = tmp_path / "multi"
    eps_fig.save_fig(savefile, format="eps")
    assert savefile.with_suffix(".eps").exists()
