def test_bitwise_addition():
    from yt.utilities.lib.geometry_utils import bitwise_addition

    # TODO: Handle negative & periodic boundaries
    lz = [
        (0, 1),
        #          (0,-1),
        (1, 1),
        (1, 2),
        (1, 4),
        (1, -1),
        (2, 1),
        (2, 2),
        (2, -1),
        (2, -2),
        (3, 1),
        (3, 5),
        (3, -1),
    ]
    for i, a in lz:
        i = np.uint64(i)
        a = np.int64(a)
        out = bitwise_addition(i, a, stride=1, start=0)
        assert_equal(out, i + a)


