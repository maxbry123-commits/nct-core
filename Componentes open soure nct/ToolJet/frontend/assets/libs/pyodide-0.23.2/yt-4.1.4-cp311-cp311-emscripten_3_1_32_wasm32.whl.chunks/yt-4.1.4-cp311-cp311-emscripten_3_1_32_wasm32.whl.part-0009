@requires_external_executable("tex")
@requires_module("pyx")
def test_eps_writer(tmp_path):
    import yt.visualization.eps_writer as eps

    fields = [
        ("gas", "density"),
        ("gas", "temperature"),
    ]
    units = [
        "g/cm**3",
        "K",
    ]
    ds = fake_amr_ds(fields=fields, units=units)
